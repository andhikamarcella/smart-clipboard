{
  "manifest_version": 3,
  "name": "Smart Admin Clipboard",
  "description": "Clipboard history manager + admin helper tools for daily productivity.",
  "version": "1.3.0",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Smart Admin Clipboard",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
